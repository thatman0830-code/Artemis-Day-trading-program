{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "backtesting.execution_accounting.v2/instrument-accounting-v2.schema.json",
  "title": "Execution and Accounting v2 Phase 4 records",
  "oneOf": [
    {"$ref":"#/$defs/fillEconomics"},
    {"$ref":"#/$defs/priceEvidence"},
    {"$ref":"#/$defs/settlement"},
    {"$ref":"#/$defs/funding"},
    {"$ref":"#/$defs/margin"},
    {"$ref":"#/$defs/event"},
    {"$ref":"#/$defs/snapshot"}
  ],
  "$defs": {
    "decimal":{"type":"string","pattern":"^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"},
    "nonnegative":{"type":"string","pattern":"^(0|[1-9][0-9]*)(\\.[0-9]+)?$"},
    "sha":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "utc":{"type":"string","format":"date-time","pattern":"Z$"},
    "identity":{"type":"object","required":["market","instrument_id","contract_id"],"properties":{
      "market":{"type":"string","minLength":1},"instrument_id":{"type":"string","minLength":1},
      "contract_id":{"type":["string","null"]}}},
    "fillEconomics":{"type":"object","additionalProperties":false,
      "required":["schema_version","economics_id","fill_id","commission","exchange_fee","slippage_cost","currency","specification_ids","cost_version"],
      "properties":{"schema_version":{"const":"fill-economics-v2-1"},"economics_id":{"$ref":"#/$defs/sha"},
        "fill_id":{"$ref":"#/$defs/sha"},"commission":{"$ref":"#/$defs/nonnegative"},
        "exchange_fee":{"$ref":"#/$defs/nonnegative"},"slippage_cost":{"$ref":"#/$defs/nonnegative"},
        "currency":{"type":"string","minLength":1},"specification_ids":{"type":"array","minItems":1,"uniqueItems":true},
        "cost_version":{"type":"string","minLength":1}}},
    "priceEvidence":{"allOf":[{"$ref":"#/$defs/identity"},{"type":"object","required":["schema_version","price_event_id","observed_at","available_at","price","price_type","specification_id","source_version"],
      "properties":{"schema_version":{"const":"price-evidence-v2-1"},"price_event_id":{"$ref":"#/$defs/sha"},
        "observed_at":{"$ref":"#/$defs/utc"},"available_at":{"$ref":"#/$defs/utc"},"price":{"$ref":"#/$defs/decimal"}}}]},
    "settlement":{"allOf":[{"$ref":"#/$defs/identity"},{"type":"object","required":["schema_version","settlement_id","settlement_time","available_at","settlement_price","specification_id","source_version"],
      "properties":{"schema_version":{"const":"settlement-fact-v2-1"},"settlement_id":{"$ref":"#/$defs/sha"},
        "settlement_time":{"$ref":"#/$defs/utc"},"available_at":{"$ref":"#/$defs/utc"},"settlement_price":{"$ref":"#/$defs/decimal"}}}]},
    "funding":{"allOf":[{"$ref":"#/$defs/identity"},{"type":"object","required":["schema_version","funding_id","funding_time","available_at","rate","mark_price","oracle_price","specification_ids","source_version"],
      "properties":{"schema_version":{"const":"funding-fact-v2-1"},"funding_id":{"$ref":"#/$defs/sha"},
        "funding_time":{"$ref":"#/$defs/utc"},"available_at":{"$ref":"#/$defs/utc"},"rate":{"$ref":"#/$defs/decimal"},
        "mark_price":{"$ref":"#/$defs/decimal"},"oracle_price":{"$ref":"#/$defs/decimal"}}}]},
    "margin":{"allOf":[{"$ref":"#/$defs/identity"},{"type":"object","required":["schema_version","margin_specification_id","effective_from","effective_to","basis","clearing_initial","clearing_maintenance","customer_initial","customer_maintenance","source_version"],
      "properties":{"schema_version":{"const":"margin-specification-v2-1"},"margin_specification_id":{"$ref":"#/$defs/sha"},
        "effective_from":{"$ref":"#/$defs/utc"},"effective_to":{"oneOf":[{"$ref":"#/$defs/utc"},{"type":"null"}]},
        "basis":{"enum":["NOTIONAL_RATE","PER_CONTRACT"]}}}]},
    "event":{"type":"object","required":["schema_version","event_id","kind","event_time","available_at"],
      "properties":{"schema_version":{"const":"accounting-event-v2-1"},"event_id":{"$ref":"#/$defs/sha"},
        "kind":{"enum":["FILL","MARK","SETTLEMENT","FUNDING"]},"event_time":{"$ref":"#/$defs/utc"},"available_at":{"$ref":"#/$defs/utc"}}},
    "snapshot":{"allOf":[{"$ref":"#/$defs/identity"},{"type":"object","required":["schema_version","snapshot_id","run_id","as_of","profile","currency","position","cash","gross_realized_pnl","unrealized_pnl","total_costs","net_result","equity","source_event_ids","accounting_version","snapshot_fingerprint"],
      "properties":{"schema_version":{"const":"instrument-accounting-snapshot-v2-1"},"snapshot_id":{"$ref":"#/$defs/sha"},
        "run_id":{"$ref":"#/$defs/sha"},"as_of":{"$ref":"#/$defs/utc"},"snapshot_fingerprint":{"$ref":"#/$defs/sha"}}}]}
  }
}
