{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "oos-evidence-readiness-v1.schema.json",
  "title": "Untouched-OOS evidence readiness plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "plan_id", "market", "dataset_id", "files", "missing_intervals", "authorities", "required_authority_kinds", "partitions", "frozen_at", "ready"],
  "properties": {
    "version": {"const": "OOS_EVIDENCE_READINESS_V1"},
    "plan_id": {"$ref": "#/$defs/sha256"},
    "market": {"enum": ["BTC", "ES", "NQ"]},
    "dataset_id": {"type": "string", "minLength": 1},
    "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}},
    "missing_intervals": {"type": "array", "items": {"$ref": "#/$defs/missing"}},
    "authorities": {"type": "array", "items": {"$ref": "#/$defs/authority"}},
    "required_authority_kinds": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "partitions": {"type": "array", "prefixItems": [
      {"$ref": "#/$defs/training"}, {"$ref": "#/$defs/validation"}, {"$ref": "#/$defs/oos"}
    ], "minItems": 3, "maxItems": 3},
    "frozen_at": {"type": "string", "format": "date-time"},
    "ready": {"const": true}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "interval": {"type": "object", "required": ["start_inclusive", "end_exclusive"], "properties": {"start_inclusive": {"type": "string", "format": "date-time"}, "end_exclusive": {"type": "string", "format": "date-time"}}},
    "file": {"type": "object", "additionalProperties": false, "required": ["relative_path", "sha256", "byte_count", "record_count", "timeframe", "start_inclusive", "end_exclusive"], "properties": {"relative_path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}, "byte_count": {"type": "integer", "minimum": 1}, "record_count": {"type": "integer", "minimum": 1}, "timeframe": {"type": "string", "minLength": 1}, "start_inclusive": {"type": "string", "format": "date-time"}, "end_exclusive": {"type": "string", "format": "date-time"}}},
    "missing": {"type": "object", "required": ["timeframe", "start_inclusive", "end_exclusive", "reason"]},
    "authority": {"type": "object", "required": ["kind", "authority_name", "source_sha256", "effective_start_inclusive", "effective_end_exclusive", "published_at", "captured_at"]},
    "partition": {"type": "object", "required": ["role", "start_inclusive", "end_exclusive"]},
    "training": {"allOf": [{"$ref": "#/$defs/partition"}, {"properties": {"role": {"const": "TRAINING"}}}]},
    "validation": {"allOf": [{"$ref": "#/$defs/partition"}, {"properties": {"role": {"const": "VALIDATION"}}}]},
    "oos": {"allOf": [{"$ref": "#/$defs/partition"}, {"properties": {"role": {"const": "UNTOUCHED_OOS"}}}]}
  }
}
