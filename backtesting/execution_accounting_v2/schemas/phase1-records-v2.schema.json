{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"phase1-records-v2.schema.json",
  "title":"Execution and Accounting v2 Phase 1 immutable records",
  "$defs":{
    "sha":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "utc":{"type":"string","format":"date-time","pattern":"Z$"},
    "decimal":{"type":"string","pattern":"^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"},
    "positive":{"type":"string","pattern":"^(0\\.[0-9]*[1-9][0-9]*|[1-9][0-9]*(\\.[0-9]+)?)$"},
    "instrument":{"type":"object","additionalProperties":false,"required":["schema_version","specification_id","market","instrument_id","contract_id","profile","currency","tick_size","quantity_step","contract_multiplier","point_value","effective_from","effective_to","evidence_ids"],"properties":{"schema_version":{"const":"instrument-spec-v2-1"},"specification_id":{"$ref":"#/$defs/sha"},"market":{"type":"string","minLength":1},"instrument_id":{"type":"string","minLength":1},"contract_id":{"type":["string","null"]},"profile":{"enum":["ES_FUTURE","NQ_FUTURE","BTC_SPOT","BTC_LINEAR_PERPETUAL","BTC_UNKNOWN_UNSUPPORTED"]},"currency":{"type":"string","minLength":1},"tick_size":{"$ref":"#/$defs/positive"},"quantity_step":{"$ref":"#/$defs/positive"},"contract_multiplier":{"$ref":"#/$defs/positive"},"point_value":{"anyOf":[{"$ref":"#/$defs/positive"},{"type":"null"}]},"effective_from":{"$ref":"#/$defs/utc"},"effective_to":{"anyOf":[{"$ref":"#/$defs/utc"},{"type":"null"}]},"evidence_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}}}},
    "owner_assumption":{"type":"object","additionalProperties":false,"required":["schema_version","assumption_id","assumption_type","market","instrument_id","effective_from","effective_to","decimal_values","owner_approved","synthetic_test_only","decision_reference"],"properties":{"schema_version":{"const":"owner-assumption-v2-1"},"assumption_id":{"$ref":"#/$defs/sha"},"assumption_type":{"type":"string"},"market":{"type":"string"},"instrument_id":{"type":"string"},"effective_from":{"$ref":"#/$defs/utc"},"effective_to":{"anyOf":[{"$ref":"#/$defs/utc"},{"type":"null"}]},"decimal_values":{"type":"array","items":{"type":"array","prefixItems":[{"type":"string"},{"$ref":"#/$defs/decimal"}],"items":false}},"owner_approved":{"type":"boolean"},"synthetic_test_only":{"type":"boolean"},"decision_reference":{"type":"string"}}},
    "order_intent":{"type":"object","additionalProperties":false,"required":["schema_version","order_id","run_id","action_id","market","instrument_id","contract_id","side","quantity","order_type","time_in_force","limit_price","stop_price","submitted_at","activation_at","expires_at","parent_order_id","replaces_order_id","configuration_version","execution_policy_version"],"properties":{"schema_version":{"const":"order-intent-v2-1"},"order_id":{"$ref":"#/$defs/sha"},"run_id":{"$ref":"#/$defs/sha"},"action_id":{"$ref":"#/$defs/sha"},"market":{"type":"string"},"instrument_id":{"type":"string"},"contract_id":{"type":["string","null"]},"side":{"enum":["BUY","SELL"]},"quantity":{"$ref":"#/$defs/positive"},"order_type":{"enum":["MARKET","LIMIT","STOP_MARKET","STOP_LIMIT"]},"time_in_force":{"enum":["DAY","GTC","IOC"]},"limit_price":{"anyOf":[{"$ref":"#/$defs/positive"},{"type":"null"}]},"stop_price":{"anyOf":[{"$ref":"#/$defs/positive"},{"type":"null"}]},"submitted_at":{"$ref":"#/$defs/utc"},"activation_at":{"$ref":"#/$defs/utc"},"expires_at":{"anyOf":[{"$ref":"#/$defs/utc"},{"type":"null"}]},"parent_order_id":{"anyOf":[{"$ref":"#/$defs/sha"},{"type":"null"}]},"replaces_order_id":{"anyOf":[{"$ref":"#/$defs/sha"},{"type":"null"}]},"configuration_version":{"type":"string"},"execution_policy_version":{"type":"string"}}},
    "fill":{"type":"object","additionalProperties":false,"required":["schema_version","fill_id","order_id","market_event_id","market","instrument_id","contract_id","fill_time","side","quantity","economic_price","reference_price","friction","fee_total","currency","execution_rule_code","execution_policy_version"],"properties":{"schema_version":{"const":"fill-v2-1"},"fill_id":{"$ref":"#/$defs/sha"},"order_id":{"$ref":"#/$defs/sha"},"market_event_id":{"$ref":"#/$defs/sha"},"market":{"type":"string"},"instrument_id":{"type":"string"},"contract_id":{"type":["string","null"]},"fill_time":{"$ref":"#/$defs/utc"},"side":{"enum":["BUY","SELL"]},"quantity":{"$ref":"#/$defs/positive"},"economic_price":{"$ref":"#/$defs/positive"},"reference_price":{"$ref":"#/$defs/positive"},"friction":{"$ref":"#/$defs/decimal"},"fee_total":{"$ref":"#/$defs/decimal"},"currency":{"type":"string"},"execution_rule_code":{"type":"string"},"execution_policy_version":{"type":"string"}}},
    "capability":{"type":"object","additionalProperties":false,"required":["schema_version","declaration_id","profile","market","instrument_id","supported_order_types","required_data_fields","specification_ids","production_eligible","reason_codes"],"properties":{"schema_version":{"const":"capability-declaration-v2-1"},"declaration_id":{"$ref":"#/$defs/sha"},"profile":{"type":"string"},"market":{"type":"string"},"instrument_id":{"type":"string"},"supported_order_types":{"type":"array","uniqueItems":true,"items":{"enum":["MARKET","LIMIT","STOP_MARKET","STOP_LIMIT"]}},"required_data_fields":{"type":"array","uniqueItems":true,"items":{"type":"string"}},"specification_ids":{"type":"array","uniqueItems":true,"items":{"type":"string"}},"production_eligible":{"type":"boolean"},"reason_codes":{"type":"array","uniqueItems":true,"items":{"type":"string"}}}},
    "order_transition":{"type":"object","additionalProperties":false,"required":["schema_version","transition_id","order_id","event_time","from_state","to_state","reason_code","source_event_ids"],"properties":{"schema_version":{"const":"order-transition-v2-1"},"transition_id":{"$ref":"#/$defs/sha"},"order_id":{"$ref":"#/$defs/sha"},"event_time":{"$ref":"#/$defs/utc"},"from_state":{"type":"string"},"to_state":{"type":"string"},"reason_code":{"type":"string"},"source_event_ids":{"type":"array","uniqueItems":true,"items":{"type":"string"}}}},
    "accounting_snapshot":{"type":"object","additionalProperties":false,"required":["schema_version","snapshot_id","run_id","as_of","currency","cash","realized_pnl","unrealized_pnl","fees","funding","equity","initial_margin","maintenance_margin","available_funds","source_event_ids","accounting_version"],"properties":{"schema_version":{"const":"accounting-snapshot-v2-1"},"snapshot_id":{"$ref":"#/$defs/sha"},"run_id":{"$ref":"#/$defs/sha"},"as_of":{"$ref":"#/$defs/utc"},"currency":{"type":"string"},"cash":{"$ref":"#/$defs/decimal"},"realized_pnl":{"$ref":"#/$defs/decimal"},"unrealized_pnl":{"$ref":"#/$defs/decimal"},"fees":{"$ref":"#/$defs/decimal"},"funding":{"$ref":"#/$defs/decimal"},"equity":{"$ref":"#/$defs/decimal"},"initial_margin":{"$ref":"#/$defs/decimal"},"maintenance_margin":{"$ref":"#/$defs/decimal"},"available_funds":{"$ref":"#/$defs/decimal"},"source_event_ids":{"type":"array","uniqueItems":true,"items":{"type":"string"}},"accounting_version":{"type":"string"}}},
    "risk_event":{"type":"object","additionalProperties":false,"required":["schema_version","risk_event_id","run_id","event_time","market","instrument_id","phase","decision","reason_codes","source_event_ids","risk_policy_version"],"properties":{"schema_version":{"const":"risk-event-v2-1"},"risk_event_id":{"$ref":"#/$defs/sha"},"run_id":{"$ref":"#/$defs/sha"},"event_time":{"$ref":"#/$defs/utc"},"market":{"type":"string"},"instrument_id":{"type":"string"},"phase":{"enum":["PRE_TRADE","POST_EVENT","SESSION","DATA_QUALITY","ROLLOVER"]},"decision":{"enum":["ALLOW","REJECT","HALT","FORCE_REDUCE","FORCE_FLATTEN"]},"reason_codes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},"source_event_ids":{"type":"array","uniqueItems":true,"items":{"type":"string"}},"risk_policy_version":{"type":"string"}}},
    "result_identity":{"type":"object","additionalProperties":false,"required":["schema_version","result_id","run_id","configuration_fingerprint","dataset_fingerprint","economic_fingerprint","strategy_version","execution_policy_version","accounting_version","risk_policy_version","started_at","ended_at","source_record_ids","simulation_only"],"properties":{"schema_version":{"const":"backtest-result-v2-1"},"result_id":{"$ref":"#/$defs/sha"},"run_id":{"$ref":"#/$defs/sha"},"configuration_fingerprint":{"$ref":"#/$defs/sha"},"dataset_fingerprint":{"$ref":"#/$defs/sha"},"economic_fingerprint":{"$ref":"#/$defs/sha"},"strategy_version":{"type":"string"},"execution_policy_version":{"type":"string"},"accounting_version":{"type":"string"},"risk_policy_version":{"type":"string"},"started_at":{"$ref":"#/$defs/utc"},"ended_at":{"$ref":"#/$defs/utc"},"source_record_ids":{"type":"array","uniqueItems":true,"items":{"type":"string"}},"simulation_only":{"const":true}}}
  },
  "oneOf":[{"$ref":"#/$defs/instrument"},{"$ref":"#/$defs/owner_assumption"},{"$ref":"#/$defs/capability"},{"$ref":"#/$defs/order_intent"},{"$ref":"#/$defs/order_transition"},{"$ref":"#/$defs/fill"},{"$ref":"#/$defs/accounting_snapshot"},{"$ref":"#/$defs/risk_event"},{"$ref":"#/$defs/result_identity"}]
}
