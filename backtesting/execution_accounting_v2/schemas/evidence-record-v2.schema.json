{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"evidence-record-v2.schema.json",
  "type":"object","additionalProperties":false,
  "required":["schema_version","evidence_id","source_organization","document_identity","local_snapshot_path","snapshot_sha256","retrieved_at","effective_from","effective_to","market","instrument_id","fact_names","assumptions_and_gaps"],
  "properties":{
    "schema_version":{"const":"evidence-record-v2-1"},"evidence_id":{"type":"string","minLength":1},"source_organization":{"type":"string","minLength":1},"document_identity":{"type":"string","minLength":1},"canonical_url":{"type":["string","null"],"format":"uri"},"local_snapshot_path":{"type":"string","minLength":1},"snapshot_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "retrieved_at":{"type":"string","format":"date-time","pattern":"Z$"},"effective_from":{"type":"string","format":"date-time","pattern":"Z$"},"effective_to":{"type":["string","null"],"format":"date-time"},"market":{"type":"string","minLength":1},"instrument_id":{"type":"string","minLength":1},"fact_names":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},"assumptions_and_gaps":{"type":"array","items":{"type":"string"}}
  }
}
