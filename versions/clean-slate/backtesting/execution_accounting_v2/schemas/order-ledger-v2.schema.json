{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"order-ledger-v2.schema.json",
  "$defs":{
    "sha":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "utc":{"type":"string","format":"date-time","pattern":"Z$"},
    "decimal":{"type":"string","pattern":"^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"},
    "event":{"type":"object","additionalProperties":false,"required":["schema_version","event_id","order_id","kind","event_time","sequence_number","expected_order_version","market","instrument_id","contract_id","source_event_id","reason_code","fill_quantity","session_boundary_verified","contract_eligibility_verified","replacement_intent","intrabar_owner"],"properties":{"schema_version":{"const":"order-ledger-event-v2-1"},"event_id":{"$ref":"#/$defs/sha"},"order_id":{"$ref":"#/$defs/sha"},"kind":{"enum":["SUBMIT","FORCED_CLOSE_INTENT","ACCEPT","REJECT","ACTIVATE","TRIGGER","FILL","EXECUTION_EVALUATED","CANCEL_REQUEST","CANCEL","EXPIRE","REPLACE"]},"event_time":{"$ref":"#/$defs/utc"},"sequence_number":{"type":"integer","minimum":1},"expected_order_version":{"type":"integer","minimum":0},"market":{"type":"string"},"instrument_id":{"type":"string"},"contract_id":{"type":["string","null"]},"source_event_id":{"$ref":"#/$defs/sha"},"reason_code":{"type":"string"},"fill_quantity":{"anyOf":[{"$ref":"#/$defs/decimal"},{"type":"null"}]},"session_boundary_verified":{"type":"boolean"},"contract_eligibility_verified":{"type":"boolean"},"replacement_intent":{"type":["object","null"]},"intrabar_owner":{"type":["string","null"]}}},
    "transition":{"type":"object","additionalProperties":false,"required":["schema_version","transition_id","ledger_version","order_id","parent_order_id","child_order_id","market","instrument_id","contract_id","event_time","sequence_number","transition_ordinal","previous_state","resulting_state","accepted_quantity","filled_quantity","remaining_quantity","reason_code","source_event_id","event_id","event_fingerprint"],"properties":{"schema_version":{"const":"order-ledger-transition-v2-1"},"transition_id":{"$ref":"#/$defs/sha"},"ledger_version":{"const":"order-ledger-v2-1"},"order_id":{"$ref":"#/$defs/sha"},"parent_order_id":{"type":["string","null"]},"child_order_id":{"type":["string","null"]},"market":{"type":"string"},"instrument_id":{"type":"string"},"contract_id":{"type":["string","null"]},"event_time":{"$ref":"#/$defs/utc"},"sequence_number":{"type":"integer","minimum":1},"transition_ordinal":{"type":"integer","minimum":1},"previous_state":{"type":"string"},"resulting_state":{"type":"string"},"accepted_quantity":{"$ref":"#/$defs/decimal"},"filled_quantity":{"$ref":"#/$defs/decimal"},"remaining_quantity":{"$ref":"#/$defs/decimal"},"reason_code":{"type":"string"},"source_event_id":{"$ref":"#/$defs/sha"},"event_id":{"$ref":"#/$defs/sha"},"event_fingerprint":{"$ref":"#/$defs/sha"}}}
  },
  "type":"object","additionalProperties":false,
  "required":["schema_version","ledger_version","orders","events","event_fingerprints","transitions","ledger_fingerprint"],
  "properties":{"schema_version":{"const":"order-ledger-v2-1"},"ledger_version":{"const":"order-ledger-v2-1"},"orders":{"type":"array","items":{"type":"object"}},"events":{"type":"array","items":{"$ref":"#/$defs/event"}},"event_fingerprints":{"type":"array","items":{"type":"array"}},"transitions":{"type":"array","items":{"$ref":"#/$defs/transition"}},"ledger_fingerprint":{"$ref":"#/$defs/sha"}}
}
