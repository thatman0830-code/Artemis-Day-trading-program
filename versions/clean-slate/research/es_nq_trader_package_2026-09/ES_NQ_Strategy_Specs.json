  "strategies": [
    {
      "id": "OR-1",
      "name": "Opening Range Continuation",
      "deployment_status": "research_only",
      "instruments": ["ES", "NQ"],
      "session_timezone": "America/New_York",
      "session_start": "09:30:00",
      "opening_range_minutes_candidates": [5, 15, 30],
      "required_features": ["or_high","or_low","or_width","atr_1m_20","vwap","vwap_slope","relative_volume","overnight_high","overnight_low","prior_day_high","prior_day_low","prior_value_area","es_nq_confirmation","event_lockout"],
      "long_trigger": "completed_bar_close > or_high + k*atr_1m_20 AND next_completed_bar_close >= or_high AND vwap_slope > 0 AND relative_volume >= rv_min",
      "short_trigger": "symmetric",
      "stop": "structural_or_atr_within_max_risk",
      "exits": ["return_inside_opening_range","time_stop","one_R_partial_candidate","structure_trail","session_flatten"],
      "no_trade": ["data_integrity_fail","event_lockout","abnormal_or_width","slippage_breaker","spread_breaker","conflicting_cross_index_state"]
    },
    {
      "id": "OR-2",
      "name": "Failed Opening Range Breakout",
      "deployment_status": "research_only",
      "instruments": ["ES", "NQ"],
      "precondition": "volatility_normalized_break_outside_OR",
      "trigger": "close_back_inside_OR_within_M_bars AND failed_follow_through",
      "entry": "failed_side_retest_or_opposite_micro_structure_break",
      "targets": ["OR_midpoint","VWAP","opposite_OR_boundary_if_value_migrates"],
      "stop": "beyond_failed_break_extreme_plus_buffer",
      "abort": ["strong_trend_day","acceptance_outside_OR","expanding_volume_in_breakout_direction"]
    },
    {
      "id": "TP-1",
      "name": "Trend Pullback Resumption",
      "deployment_status": "research_only",
      "instruments": ["ES", "NQ"],
      "trend_vote_minimum": 3,
      "trend_votes": ["vwap_slope","directional_efficiency","5_15_60m_structure_alignment","outside_prior_value","cumulative_delta_slope","range_volume_expansion"],
      "pullback_bars_min": 2,
      "pullback_bars_max": 8,
      "retracement_fraction_candidates": [[0.25,0.65]],
      "trigger": "micro_swing_break_with_range_volume_reexpansion",
      "stop": "beyond_pullback_extreme",
      "exits": ["one_R_partial_candidate","confirmed_swing_trail","vwap_band_trail","time_stop","session_flatten"]
    },
    {
      "id": "AR-1",
      "name": "Auction Rejection Acceptance",
      "deployment_status": "research_only",
      "instruments": ["ES", "NQ"],
      "reference_levels": ["prior_VAH","prior_VAL","prior_POC","overnight_high","overnight_low","initial_balance_high","initial_balance_low","weekly_VWAP"],
      "rejection_definition": "excursion_then_return_with_low_time_and_volume_outside",
      "acceptance_definition": "minimum_time_or_volume_outside_with_value_migration",
      "responsive_target": "VWAP_or_POC",
      "initiative_entry": "first_controlled_pullback_after_acceptance",
      "order_flow_role": "confirmation_only"
    },
    {
      "id": "SQ-1",
      "name": "Compression Expansion",
      "deployment_status": "research_only",
      "instruments": ["ES", "NQ"],
      "features": ["bollinger_width","keltner_width","realized_volatility_percentile","range_compression","relative_volume","momentum","higher_timeframe_trend"],
      "trigger": "completed_bar_release_from_compression_with_volume_and_momentum_confirmation",
      "exits": ["failed_release","momentum_decay","ATR_trail","session_flatten"],
      "anti_lookahead": "completed_bars_only"
    },
    {
      "id": "MS-1",
      "name": "Multi-Timeframe Sweep To Equilibrium",
      "deployment_status": "research_only",
      "instruments": ["ES", "NQ"],
      "context_timeframes": ["1D","4H","1H"],
      "execution_timeframes": ["30m","5m","1m"],
      "swing_rule": "causal_confirmed_pivot",
      "trigger": "sweep_confirmed_swing_then_close_back_and_opposite_micro_structure_break",
      "entry": "confirmation_close_or_first_retest",
      "targets": ["active_range_midpoint","VWAP_or_POC_if_aligned"],
      "stop": "beyond_sweep_extreme_plus_volatility_buffer"
    }
  ],
